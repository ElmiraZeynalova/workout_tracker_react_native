{
  "expo": {
    "name": "workout_tracker",
    "slug": "workout_tracker",
    "scheme": "workouttracker",
    "version": "1.0.0",
    "extra": {
      "EXPO_PUBLIC_SUPABASE_URL": "https://wxdhjdmxwollqlsabmpi.supabase.co",
      "EXPO_PUBLIC_SUPABASE_KEY": "sb_publishable_LxTTbCj0MmOV5JD5v-ltJw_kA0ZrmaV",
      "router": {},
      "eas": {
        "projectId": "65c49629-f913-4c79-bc19-5eac27d10569"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.workout_tracker"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
